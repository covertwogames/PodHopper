<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- PodHopper: user files are not a PodHopper feature, so this screen is no longer offered to
             other apps as a share, open-document or open-with target. The app still opens it directly. -->
        <activity android:name=".cloud.AddFileActivity"
            android:launchMode="singleTop"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <!--
            PodHopper: the Android account authenticator was removed. Sign-in moved to PodHopper's
            own backend and no account is ever created through AccountManager, but registering the
            authenticator still published an account type named after the upstream project, which
            any app on the device could enumerate. The sync code that reads AccountManager is
            unchanged and simply finds no accounts, exactly as it did before.
        -->
    </application>

</manifest>