<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- PodHopper: agreeing to the Terms of Service and Privacy Policy. -->

    <!-- The two link phrases. Every sentence below that carries links must contain both of them
         word for word, Terms first, because the links are found by matching this exact text. -->
    <string name="podhopper_terms_link_terms">Terms of Service</string>
    <string name="podhopper_terms_link_privacy">Privacy Policy</string>

    <!-- Phone: create account. The box must be ticked before an account is created. -->
    <string name="podhopper_terms_checkbox">I agree to the Terms of Service and Privacy Policy</string>
    <string name="podhopper_terms_checkbox_required">Please agree to the Terms of Service and Privacy Policy to create an account</string>

    <!-- Phone: log in, and continue without an account -->
    <string name="podhopper_terms_login_notice">By logging in you agree to the Terms of Service and Privacy Policy.</string>
    <string name="podhopper_terms_skip_notice">By continuing you agree to the Terms of Service and Privacy Policy.</string>

    <!-- Phone: shown once to people who were already using PodHopper before the Terms existed -->
    <string name="podhopper_terms_prompt_title">PodHopper now has Terms of Service</string>
    <string name="podhopper_terms_prompt_message">Please take a moment to read them, along with our Privacy Policy. They cover how PodHopper works, your account, and using PodHopper in a vehicle.</string>
    <string name="podhopper_terms_prompt_read_terms">Read the Terms of Service</string>
    <string name="podhopper_terms_prompt_read_privacy">Read the Privacy Policy</string>
    <string name="podhopper_terms_prompt_agree">Agree and continue</string>
    <string name="podhopper_terms_prompt_footer">By tapping Agree and continue you agree to the Terms of Service and Privacy Policy.</string>

    <!-- Car: sign-in screen and the built-in Terms page -->
    <string name="podhopper_car_terms_notice">By signing in you agree to the PodHopper Terms of Service and Privacy Policy.</string>
    <string name="podhopper_car_terms_read">Read the Terms</string>
    <string name="podhopper_car_terms_back">Back to sign in</string>
    <string name="podhopper_car_terms_effective">Effective date: %1$s</string>
    <string name="podhopper_car_terms_current">The current version is always at podhopper.app/terms</string>

    <!-- Watch: sign-in screen -->
    <string name="podhopper_watch_terms_notice">By signing in you agree to our Terms and Privacy Policy. Read them at podhopper.app/terms</string>

</resources>
