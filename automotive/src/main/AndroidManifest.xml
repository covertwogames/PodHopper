<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.wifi"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.screen.landscape"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.screen.portrait"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>
    <!-- PodHopper: episode downloads run as dataSync foreground work (DownloadEpisodeWorker).
         The phone manifest has carried this permission all along; without it the OS kills the
         process on every download attempt, which on the car surfaced as playback stopping every
         ~25 seconds while Up Next auto-download retried. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove"/>

    <application
        android:name=".AutomotiveApplication"
        android:allowBackup="true"
        android:icon="${appIcon}"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Automotive.ThemeDark"
        android:appCategory="audio"
        android:usesCleartextTraffic="true"
        android:largeHeap="true">

        <meta-data android:name="com.android.automotive"
            android:resource="@xml/automotive_app_desc"/>

        <activity android:name=".AutomotiveSettingsActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.APPLICATION_PREFERENCES"/>
            </intent-filter>
        </activity>

        <!-- PodHopper: car sign-in (pairing). Launched while parked from the media browser's
             "Sign In" resolution action and from car Settings. Not distraction optimized, so the
             system only allows it while the vehicle is parked. -->
        <activity android:name=".PodHopperCarPairingActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Automotive.ThemeDark">
            <intent-filter>
                <action android:name="au.com.shiftyjelly.pocketcasts.intents.PAIR_CAR"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </activity>

        <service
            android:name=".AutoPlaybackService"
            android:exported="true"
            android:enabled="true"
            android:label="@string/app_name"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService" />
                <action android:name="androidx.media3.session.MediaLibraryService" />
            </intent-filter>
        </service>

        <!-- services which are periodic or trigerred by the app automatically triggered, eg: can run in the background -->
        <service android:name=".repositories.refresh.RefreshPodcastsJob"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="true"/>

        <!-- Work Manager -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <!-- If you are using androidx.startup to initialize other components -->
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- Disable Advertising ID collection -->
        <meta-data android:name="google_analytics_adid_collection_enabled" android:value="false"/>

        <meta-data
            android:name="podhopper_automotive"
            android:value="true" />
    </application>

</manifest>
