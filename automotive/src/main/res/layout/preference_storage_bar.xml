<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="?android:attr/listPreferredItemPaddingStart"
    android:paddingEnd="?android:attr/listPreferredItemPaddingEnd"
    android:paddingTop="16dp"
    android:paddingBottom="16dp">

    <TextView
        android:id="@+id/storage_bar_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/podhopper_storage_title"
        android:textAppearance="?android:attr/textAppearanceListItem" />

    <LinearLayout
        android:id="@+id/storage_bar_track"
        android:layout_width="match_parent"
        android:layout_height="14dp"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <View
            android:id="@+id/storage_segment_app"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0"
            android:background="#4CAF50" />

        <View
            android:id="@+id/storage_segment_other"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0"
            android:background="#E53935" />

        <View
            android:id="@+id/storage_segment_free"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#616161" />
    </LinearLayout>

    <TextView
        android:id="@+id/storage_bar_summary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/podhopper_storage_calculating"
        android:textAppearance="?android:attr/textAppearanceListItemSecondary" />
</LinearLayout>
